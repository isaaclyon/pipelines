{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.cjs"],
  "exclude": ["node_modules"]
}
