#!/bin/sh
# Block commits that add secrets. Enable with: git config core.hooksPath .githooks
set -eu
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed; install it (brew install gitleaks)" >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
