FROM ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv

FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS dependencies
COPY --from=uv /uv /uvx /usr/local/bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
ARG PROJECT_DIR
WORKDIR /workspace/${PROJECT_DIR}
# Path dependency of every Python project that reads client.yaml.
COPY packages/client-config/ /workspace/packages/client-config/
COPY ${PROJECT_DIR}/pyproject.toml ${PROJECT_DIR}/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

FROM dependencies AS lineage
# Independent CLI environment: Colibri and dagster-dbt require different sqlglot versions.
COPY packages/transformations/lineage/ /opt/lineage-project/
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$PROJECT_DIR" = packages/transformations ]; then \
      UV_PROJECT_ENVIRONMENT=/opt/lineage uv sync --project /opt/lineage-project --frozen --no-dev --no-install-project; \
    else mkdir /opt/lineage; fi

FROM dependencies AS build
COPY ${PROJECT_DIR}/ ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-editable

FROM dependencies AS check-dependencies
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-install-project

FROM check-dependencies AS checks
COPY --from=lineage /opt/lineage /opt/lineage
ENV COLIBRI_EXECUTABLE=/opt/lineage/bin/colibri
COPY ${PROJECT_DIR}/ ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-editable
COPY ruff.toml /workspace/ruff.toml
COPY scripts/check-python.sh /workspace/scripts/check-python.sh
# The transformations tests run analytics-check-client on the sample client.
COPY examples/sample-client/ /workspace/examples/sample-client/
RUN useradd --uid 10001 --create-home analytics && chown -R analytics /workspace
ENV PATH="/opt/venv/bin:${PATH}"
USER analytics
ENTRYPOINT ["sh", "/workspace/scripts/check-python.sh"]

FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS runtime
RUN useradd --uid 10001 --create-home analytics && \
    mkdir -p /opt/dagster /var/lib/analytics && chown -R analytics /opt/dagster /var/lib/analytics
COPY --from=build /opt/venv /opt/venv
COPY --from=lineage /opt/lineage /opt/lineage
ENV COLIBRI_EXECUTABLE=/opt/lineage/bin/colibri
COPY deploy/dagster/dagster.yaml deploy/dagster/workspace.yaml /opt/dagster/
COPY deploy/dagster/check-concurrency.py /opt/dagster/
COPY --chmod=755 scripts/container-entrypoint.sh /usr/local/bin/container-entrypoint
# Transformations: the toolkit's dbt package (ANALYTICS_TOOLKIT_DBT), which a
# client project installs, and the toolkit-owned dbt targets (DBT_PROFILES_DIR).
# A client image adds its dbt project at DBT_PROJECT_DIR; this image alone has
# none, so its dbt work fails until one is added.
ENV PATH="/opt/venv/bin:${PATH}" \
    DAGSTER_HOME=/opt/dagster \
    ANALYTICS_TOOLKIT_DBT=/opt/venv/lib/python3.12/site-packages/analytics_transformations/dbt \
    DBT_PROJECT_DIR=/opt/client/dbt \
    DBT_PROFILES_DIR=/opt/venv/lib/python3.12/site-packages/analytics_transformations/dbt \
    DBT_TARGET_PATH=/var/lib/analytics/artifacts/dbt \
    DBT_LOG_PATH=/var/lib/analytics/artifacts/dbt-logs
WORKDIR /opt/dagster
USER analytics
ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
