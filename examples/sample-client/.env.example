# The settings a deployment of this client reads from its environment file.
# Copy this file to .env and fill it in; .env holds secrets, so it never
# enters Git or an image. Render it from your secret store if you use one.
# Settings that are not secret, such as sources and the reporting time zone,
# belong in client.yaml instead.
#
# Today the toolkit's local stack runs a client:
#   CLIENT_DIR=/path/to/this/repository ANALYTICS_ENV_FILE=/path/to/this/repository/.env \
#       ./scripts/platform local up
# The toolkit's deploy/compose/README.md lists every setting each service reads.

# --- Required ---------------------------------------------------------------

# Password of the Postgres database that holds Dagster's run history.
DAGSTER_POSTGRES_PASSWORD=
# Signs Cube API tokens. At least 32 random characters.
CUBEJS_API_SECRET=

# --- dbt documentation site (optional) --------------------------------------

# Start the password-protected docs site. Leave all three unset to skip it.
#COMPOSE_PROFILES=docs
# The site address Caddy serves, such as http://:8080 locally.
#DOCS_SITE_ADDRESS=
# bcrypt hash of the docs password for user "analytics", base64-encoded:
#   docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext '<password>' | tr -d '\n' | base64
#DOCS_PASSWORD_HASH=

# --- Secret files (paths on the host, each mounted read-only) ---------------

# Folder of source settings files, one JSON file per system: shopify.json
# (shop_domain and access_token, used by shopify_orders and shopify_customers),
# loop_returns.json, goodday.json, google_sheets.json and impact_radius.json.
# Unset mounts an empty folder, and each source fails before it reads anything.
#SOURCE_SETTINGS_HOST_DIR=/path/outside/the/repository/sources
# One Slack incoming-webhook URL. Read only when client.yaml sets alerts.slack.
#SLACK_WEBHOOK_HOST_PATH=/path/outside/the/repository/slack-webhook

# --- Local ports (optional) -------------------------------------------------

#DAGSTER_PORT=3000
#CUBE_PORT=4000
#DOCS_PORT=8080
